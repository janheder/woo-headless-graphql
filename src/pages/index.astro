---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchGQL } from '../lib/fetch-gql';
import { GET_PRODUCTS, GET_CATEGORIES } from '../lib/queries';
import type { GetProductsResponse, GetCategoriesResponse } from '../types/woo.types';
import { rewriteAssetUrl } from '../lib/utils';

// Fetch live products and categories from WooCommerce via WPGraphQL
const [productsData, categoriesData] = await Promise.all([
  fetchGQL<GetProductsResponse>(GET_PRODUCTS, { first: 12 }),
  fetchGQL<GetCategoriesResponse>(GET_CATEGORIES, { first: 12 })
]);

const products = productsData?.products?.nodes || [];
const categories = categoriesData?.productCategories?.nodes || [];
---

<Layout title="Headless WooCommerce | Úvod" description="Moderní, rychlý headless e-shop běžící na Astro, Svelte a WooCommerce rozhraní.">
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-tag">Astro + Svelte 5 + WooGraphQL</span>
        <h1 class="hero-title">Rychlost statického webu, síla WooCommerce.</h1>
        <p class="hero-desc">
          Zažijte neuvěřitelně rychlé načítání díky hybridnímu renderování Astro. Veškerý katalog je předgenerován, zatímco košík funguje dynamicky přes WooCommerce proxy.
        </p>
        <div class="hero-actions">
          <a href="#katalog" class="btn btn-primary">Prozkoumat produkty</a>
          <a href="/cart" class="btn btn-outline">Zobrazit košík</a>
        </div>
      </div>
    </div>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="container">
      
      <!-- Category Grid Navigation -->
      {categories.length > 0 && (
        <div class="category-nav">
          <div class="section-header">
            <h2 class="section-title">Kategorie produktů</h2>
            <p class="section-subtitle">Prohlížejte zboží podle jednotlivých kategorií</p>
          </div>
          <div class="category-grid">
            {categories.map(category => {
              const catImage = category.image?.sourceUrl ? rewriteAssetUrl(category.image.sourceUrl) : null;
              return (
                <a href={`/category/${category.slug}`} class="category-card">
                  <div class="category-image-wrapper">
                    {catImage ? (
                      <img src={catImage} alt={category.name} class="category-image" loading="lazy" />
                    ) : (
                      <div class="category-image-placeholder">☕</div>
                    )}
                  </div>
                  <div class="category-content">
                    <span class="category-name">{category.name}</span>
                    <span class="category-count">{category.count || 0} produktů</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Popular Products Section -->
      <div class="products-section">
        <div class="section-header">
          <h2 class="section-title">Populární produkty</h2>
          <p class="section-subtitle">Aktuální výběr z našeho kompletního sortimentu</p>
        </div>

        {products.length > 0 ? (
          <div class="product-grid">
            {products.map(product => (
              <ProductCard product={product} />
            ))}
          </div>
        ) : (
          <div class="no-products">
            <p>Momentálně nemáme v katalogu žádné produkty. Zkontrolujte prosím připojení k administraci.</p>
          </div>
        )}
      </div>

    </div>
  </section>
</Layout>

<style>
  .hero-section {
    padding: var(--spacing-xxxl) 0;
    background: radial-gradient(circle at top right, hsl(327, 60%, 97%) 0%, var(--color-bg) 60%);
    border-bottom: 0.1rem solid var(--color-border);
  }

  .hero-container {
    display: flex;
    align-items: center;
    min-height: 40.0rem;
  }

  .hero-content {
    max-width: 65.0rem;
    animation: slideUp var(--transition-slow) ease-out;
  }

  .hero-tag {
    display: inline-block;
    padding: var(--spacing-xxs) var(--spacing-md);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 4.8rem;
    line-height: 1.15;
    margin-bottom: var(--spacing-md);
    letter-spacing: -0.03em;
  }

  .hero-desc {
    font-size: 1.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-sm) var(--spacing-xl);
    font-size: 1.5rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
    text-decoration: none;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-0.2rem);
    box-shadow: 0 0.4rem 1.2rem rgba(171, 71, 129, 0.2);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-text);
    border: 0.2rem solid var(--color-border);
  }

  .btn-outline:hover {
    border-color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  /* Catalog Sections */
  .catalog-section {
    padding: var(--spacing-xxl) 0;
  }

  .category-nav {
    margin-bottom: var(--spacing-xxxl);
    animation: fadeIn var(--transition-normal) ease-out;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-xxl);
  }

  .section-title {
    font-size: 3.2rem;
    margin-bottom: var(--spacing-xs);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.6rem;
    color: var(--color-text-muted);
    max-width: 60.0rem;
    margin: 0 auto;
  }

  /* Category Navigation Grid */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18.0rem, 1fr));
    gap: var(--spacing-md);
  }

  .category-card {
    background-color: var(--color-surface);
    border: 0.1rem solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-md);
    transition: all var(--transition-normal);
  }

  .category-card:hover {
    transform: translateY(-0.4rem);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .category-image-wrapper {
    width: 7.2rem;
    height: 7.2rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-image-placeholder {
    font-size: 3.2rem;
  }

  .category-content {
    display: flex;
    flex-direction: column;
  }

  .category-name {
    font-size: 1.6rem;
    font-weight: 600;
  }

  .category-count {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  /* Products Catalog */
  .products-section {
    padding-top: var(--spacing-xl);
    animation: fadeIn var(--transition-normal) ease-out;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28.0rem, 1fr));
    gap: var(--spacing-xl);
  }

  .no-products, .no-categories {
    text-align: center;
    padding: var(--spacing-xxl) var(--spacing-lg);
    background-color: var(--color-surface);
    border: 0.1rem solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .no-products p {
    font-size: 1.6rem;
    color: var(--color-text-muted);
  }
</style>
