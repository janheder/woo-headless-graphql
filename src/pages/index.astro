---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchGQL } from '../lib/fetch-gql';
import { GET_PRODUCTS, GET_CATEGORIES } from '../lib/queries';
import type { GetProductsResponse, GetCategoriesResponse, Category } from '../types/woo.types';
import { rewriteAssetUrl } from '../lib/utils';

// Fetch live products and categories from WooCommerce via WPGraphQL
const [productsData, categoriesData] = await Promise.all([
  fetchGQL<GetProductsResponse>(GET_PRODUCTS, { first: 12 }),
  fetchGQL<GetCategoriesResponse>(GET_CATEGORIES, { first: 12 })
]);

const products = productsData?.products?.nodes || [];
const categories = categoriesData?.productCategories?.nodes || [];

/**
 * Get the accurate product count for a category, including products from child subcategories.
 * Uses offsetPagination.total from the products connection (more accurate than `category.count`
 * which only counts directly assigned products).
 */
function getCategoryCount(category: Category): number {
  return category.products?.pageInfo?.offsetPagination?.total ?? category.count ?? 0;
}

/**
 * Format the product count with correct Czech pluralization.
 */
function formatCount(count: number): string {
  if (count === 1) return '1 produkt';
  if (count >= 2 && count <= 4) return `${count} produkty`;
  return `${count} produktů`;
}
---

<Layout title="Headless WooCommerce | Úvod" description="Moderní, rychlý headless e-shop běžící na Astro, Svelte a WooCommerce rozhraní.">
  <Hero />

  <section id="katalog" class="catalog-section">
    <div class="container">
      
      <!-- Category Grid Navigation -->
      {categories.length > 0 && (
        <div class="category-nav">
          <div class="section-header">
            <h2 class="section-title">Kategorie produktů</h2>
            <p class="section-subtitle">Prohlížejte zboží podle jednotlivých kategorií</p>
          </div>
          <div class="category-grid">
            {categories.map(category => {
              const catImage = category.image?.sourceUrl ? rewriteAssetUrl(category.image.sourceUrl) : null;
              const catCount = getCategoryCount(category);
              return (
                <a href={`/category/${category.slug}`} class="category-card">
                  <div class="category-image-wrapper">
                    {catImage ? (
                      <img src={catImage} alt={category.name} class="category-image" loading="lazy" />
                    ) : (
                      <div class="category-image-placeholder">☕</div>
                    )}
                  </div>
                  <div class="category-content">
                    <span class="category-name">{category.name}</span>
                    <span class="category-count">{formatCount(catCount)}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Popular Products Section -->
      <div class="products-section">
        <div class="section-header">
          <h2 class="section-title">Populární produkty</h2>
          <p class="section-subtitle">Aktuální výběr z našeho kompletního sortimentu</p>
        </div>

        {products.length > 0 ? (
          <div class="product-grid">
            {products.map(product => (
              <ProductCard product={product} />
            ))}
          </div>
        ) : (
          <div class="no-products">
            <p>Momentálně nemáme v katalogu žádné produkty. Zkontrolujte prosím připojení k administraci.</p>
          </div>
        )}
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Catalog Sections */
  .catalog-section {
    padding: var(--spacing-xxl) 0;
  }

  .category-nav {
    margin-bottom: var(--spacing-xxxl);
    animation: fadeIn var(--transition-normal) ease-out;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-xxl);
  }

  .section-title {
    font-size: 3.2rem;
    margin-bottom: var(--spacing-xs);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.6rem;
    color: var(--color-text-muted);
    max-width: 60.0rem;
    margin: 0 auto;
  }

  /* Category Navigation Grid */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18.0rem, 1fr));
    gap: var(--spacing-md);
  }

  .category-card {
    background-color: var(--color-surface);
    border: 0.1rem solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-md);
    transition: all var(--transition-normal);
  }

  .category-card:hover {
    transform: translateY(-0.4rem);
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .category-image-wrapper {
    width: 7.2rem;
    height: 7.2rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-image-placeholder {
    font-size: 3.2rem;
  }

  .category-content {
    display: flex;
    flex-direction: column;
  }

  .category-name {
    font-size: 1.6rem;
    font-weight: 600;
  }

  .category-count {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  /* Products Catalog */
  .products-section {
    padding-top: var(--spacing-xl);
    animation: fadeIn var(--transition-normal) ease-out;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28.0rem, 1fr));
    gap: var(--spacing-xl);
  }

  .no-products, .no-categories {
    text-align: center;
    padding: var(--spacing-xxl) var(--spacing-lg);
    background-color: var(--color-surface);
    border: 0.1rem solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .no-products p {
    font-size: 1.6rem;
    color: var(--color-text-muted);
  }
</style>
