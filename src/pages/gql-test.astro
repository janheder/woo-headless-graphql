---
import Layout from '../layouts/Layout.astro';
import { fetchGQL } from '../lib/fetch-gql';
import { GET_PRODUCTS } from '../lib/queries';
import type { GetProductsResponse, Product } from '../types/woo.types';

// Set prerender to false to run dynamically on request in SSR mode for real-time verification
export const prerender = false;

let products: Product[] = [];
let error: any = null;

try {
  const data = await fetchGQL<GetProductsResponse>(GET_PRODUCTS, { first: 5 });
  products = data?.products?.nodes || [];
} catch (err) {
  error = err;
}
---

<Layout title="GraphQL Test">
  <div class="container" style="padding: var(--spacing-xxl) 0;">
    <h1 style="margin-bottom: var(--spacing-lg);">GraphQL Backend Connection Test</h1>
    
    {products.length > 0 ? (
      <div style="animation: fadeIn var(--transition-normal) ease-out;">
        <div style="background-color: hsl(150, 60%, 95%); border: 0.1rem solid var(--color-success); border-radius: var(--radius-md); padding: var(--spacing-md); margin-bottom: var(--spacing-xl);">
          <p style="color: var(--color-success); font-weight: 600; font-size: 1.8rem; margin-bottom: 0;">
            ✓ Successfully connected to WPGraphQL & WooGraphQL! Fetched {products.length} products.
          </p>
        </div>
        
        <h2 style="font-size: 2.2rem; margin-bottom: var(--spacing-md);">Sample Products:</h2>
        <ul style="display: flex; flex-direction: column; gap: var(--spacing-sm);">
          {products.map(p => (
            <li style="padding: var(--spacing-md); border: 0.1rem solid var(--color-border); border-radius: var(--radius-md); background-color: var(--color-surface); display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong style="font-size: 1.8rem;">{p.name}</strong>
                <span style="display: block; font-size: 1.3rem; color: var(--color-text-muted);">
                  Slug: <code>{p.slug}</code> | ID: {p.databaseId}
                </span>
              </div>
              <span style="color: var(--color-primary); font-size: 2.0rem; font-weight: 700;">
                {p.price || 'N/A'}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div style="background-color: hsl(0, 75%, 95%); border: 0.1rem solid var(--color-error); border-radius: var(--radius-md); padding: var(--spacing-md);">
        <p style="color: var(--color-error); font-weight: 600; font-size: 1.8rem; margin-bottom: var(--spacing-sm);">
          ✗ Failed to retrieve products from WooCommerce backend.
        </p>
        {error && <pre style="font-size: 1.4rem; overflow: auto; padding: var(--spacing-sm); background-color: rgba(0,0,0,0.05); border-radius: var(--radius-xs);">{error.toString()}</pre>}
        <p style="margin-bottom: 0; font-size: 1.5rem; color: var(--color-text-muted);">
          Please check that your WordPress server is active and WPGraphQL/WooGraphQL is enabled at <code>https://backend.janheder.space/graphql</code>.
        </p>
      </div>
    )}
    
    <div style="margin-top: var(--spacing-xxl);">
      <a href="/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline;">
        ← Back to home
      </a>
    </div>
  </div>
</Layout>
