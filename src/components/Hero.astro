---
/**
 * Hero.astro
 *
 * Full-width hero carousel using SplideJS (https://www.npmjs.com/package/@splidejs/splide).
 * Renders server-side slide markup and hydrates the carousel on the client.
 *
 * @usage
 *   <Hero />
 */
/* SplideJS core + default theme styles */
import '@splidejs/splide/css';
---

<section class="hero-carousel" aria-label="Hero Carousel">
  <div id="hero-slider" class="splide" data-splide='{"type":"loop","perPage":1,"autoplay":true,"pauseOnHover":true,"resetProgress":false,"arrows":true,"pagination":true,"speed":800,"interval":5000,"lazyLoad":"nearby"}'>
    <div class="splide__track">
      <ul class="splide__list">
        <!-- Slide 1 -->
        <li class="splide__slide">
          <div class="slide-bg slide-bg--1">
            <div class="container slide-container">
              <div class="slide-content">
                <span class="slide-tag">Novinka</span>
                <h2 class="slide-title">Objevte podzimní kolekci</h2>
                <p class="slide-desc">
                  Teplé barvy, pohodlné materiály a nadčasový design. Nechte se inspirovat naší nejnovější řadou.
                </p>
                <div class="slide-actions">
                  <a href="/category/podzimni-kolekce" class="btn btn-primary">Prozkoumat</a>
                  <a href="#katalog" class="btn btn-outline">Všechny produkty</a>
                </div>
              </div>
              <div class="slide-visual">
                <div class="slide-placeholder">
                  <span class="placeholder-icon">🍂</span>
                </div>
              </div>
            </div>
          </div>
        </li>

        <!-- Slide 2 -->
        <li class="splide__slide">
          <div class="slide-bg slide-bg--2">
            <div class="container slide-container">
              <div class="slide-content">
                <span class="slide-tag">Akce</span>
                <h2 class="slide-title">Doprava zdarma při nákupu nad 1 500 Kč</h2>
                <p class="slide-desc">
                  Užijte si bezplatné doručení až domů. Platí pro všechny objednávky nad 1 500 Kč do konce měsíce.
                </p>
                <div class="slide-actions">
                  <a href="#katalog" class="btn btn-primary">Nakupovat</a>
                  <a href="/cart" class="btn btn-outline">Košík</a>
                </div>
              </div>
              <div class="slide-visual">
                <div class="slide-placeholder">
                  <span class="placeholder-icon">📦</span>
                </div>
              </div>
            </div>
          </div>
        </li>

        <!-- Slide 3 -->
        <li class="splide__slide">
          <div class="slide-bg slide-bg--3">
            <div class="container slide-container">
              <div class="slide-content">
                <span class="slide-tag">Tip</span>
                <h2 class="slide-title">Noví zákazníci získávají 10% slevu</h2>
                <p class="slide-desc">
                  Přihlaste se k odběru newsletteru a jako bonus obdržíte slevový kód na první nákup.
                </p>
                <div class="slide-actions">
                  <a href="#newsletter" class="btn btn-primary">Chci slevu</a>
                  <a href="#katalog" class="btn btn-outline">Prohlížet</a>
                </div>
              </div>
              <div class="slide-visual">
                <div class="slide-placeholder">
                  <span class="placeholder-icon">🎉</span>
                </div>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import Splide from '@splidejs/splide';

  /**
   * Initialize the hero Splide carousel.
   * Uses `astro:page-load` so it fires on initial load AND after every
   * View Transition swap (when the DOM is replaced but `DOMContentLoaded`
   * does not fire again).
   */
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('hero-slider');
    if (el instanceof HTMLElement) {
      new Splide(el, {
        type: 'fade',
        rewind: true,
        autoplay: true,
        interval: 6000,
        pauseOnHover: false,
        arrows: true,
        pagination: true,
        speed: 1200,
        easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
      }).mount();
    }
  });
</script>

<style>
  /* =============================================
     Hero Carousel – Outer Wrapper
     ============================================= */
  .hero-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* =============================================
     Splide Overrides
     ============================================= */
  .hero-carousel .splide {
    visibility: visible;
  }

  .hero-carousel .splide__track {
    border-radius: 0;
  }

  .hero-carousel .splide__arrow {
    background-color: var(--color-surface);
    opacity: 0.9;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-lg);
    transition: all var(--transition-fast);
  }

  .hero-carousel .splide__arrow svg {
    fill: var(--color-text);
    width: 2.0rem;
    height: 2.0rem;
  }

  .hero-carousel .splide__arrow:hover {
    opacity: 1;
    background-color: var(--color-surface);
    transform: scale(1.08);
  }

  .hero-carousel .splide__arrow--prev {
    left: 1.6rem;
  }

  .hero-carousel .splide__arrow--next {
    right: 1.6rem;
  }

  .hero-carousel .splide__pagination {
    bottom: 2.4rem;
    gap: 0.8rem;
  }

  .hero-carousel .splide__pagination__page {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: var(--radius-full);
    background-color: var(--color-text-light);
    opacity: 0.5;
    transition: all var(--transition-fast);
  }

  .hero-carousel .splide__pagination__page.is-active {
    background-color: var(--color-primary);
    opacity: 1;
    transform: scale(1.2);
  }

  /* =============================================
     Slide Backgrounds
     ============================================= */
  .slide-bg {
    display: flex;
    align-items: center;
    min-height: 52.0rem;
    padding: var(--spacing-xxl) 0;
  }

  .slide-bg--1 {
    background: linear-gradient(135deg, hsl(30, 80%, 96%) 0%, hsl(20, 70%, 92%) 100%);
  }

  .slide-bg--2 {
    background: linear-gradient(135deg, hsl(200, 60%, 95%) 0%, hsl(180, 50%, 90%) 100%);
  }

  .slide-bg--3 {
    background: linear-gradient(135deg, hsl(330, 50%, 95%) 0%, hsl(300, 40%, 92%) 100%);
  }

  /* =============================================
     Slide Layout
     ============================================= */
  .slide-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xxl);
    align-items: center;
  }

  .slide-content {
    animation: slideUp var(--transition-slow) ease-out;
  }

  .slide-tag {
    display: inline-block;
    padding: var(--spacing-xxs) var(--spacing-md);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .slide-title {
    font-size: 4.0rem;
    line-height: 1.15;
    margin-bottom: var(--spacing-md);
    letter-spacing: -0.03em;
  }

  .slide-desc {
    font-size: 1.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xl);
    max-width: 48.0rem;
  }

  .slide-actions {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  /* =============================================
     Slide Visual / Placeholder
     ============================================= */
  .slide-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-placeholder {
    width: 28.0rem;
    height: 28.0rem;
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn var(--transition-slow) ease-out;
  }

  .placeholder-icon {
    font-size: 10.0rem;
    line-height: 1;
    user-select: none;
  }

  /* =============================================
     Buttons (reuse existing project styles)
     ============================================= */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-sm) var(--spacing-xl);
    font-size: 1.5rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
    text-decoration: none;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-0.2rem);
    box-shadow: 0 0.4rem 1.2rem rgba(171, 71, 129, 0.2);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-text);
    border: 0.2rem solid var(--color-border);
  }

  .btn-outline:hover {
    border-color: var(--color-text);
    background-color: var(--color-surface-hover);
  }

  /* =============================================
     Responsive
     ============================================= */
  @media (max-width: 768px) {
    .slide-bg {
      min-height: auto;
      padding: var(--spacing-xl) 0;
    }

    .slide-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .slide-title {
      font-size: 3.2rem;
    }

    .slide-desc {
      margin-left: auto;
      margin-right: auto;
    }

    .slide-actions {
      justify-content: center;
    }

    .slide-visual {
      display: none;
    }

    .hero-carousel .splide__arrow {
      width: 3.6rem;
      height: 3.6rem;
    }

    .hero-carousel .splide__arrow--prev {
      left: 0.8rem;
    }

    .hero-carousel .splide__arrow--next {
      right: 0.8rem;
    }
  }
</style>
