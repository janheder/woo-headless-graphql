---
import { fetchGQL } from '../lib/fetch-gql';
import { GET_MENU } from '../lib/queries';
import type { GetMenuResponse, MenuItem } from '../types/woo.types';

interface Props {
  /** Theme location to query (e.g. "primary", "secondary") */
  menuLocation?: string;
  /** Menu slug to query by SLUG idType (fallback if location not found) */
  menuSlug?: string;
}

const { menuLocation = 'primary', menuSlug } = Astro.props;

// Default to LOCATION query, fallback to SLUG if menuSlug prop is explicitly provided
const idType = menuSlug ? 'SLUG' : 'LOCATION';
const id = menuSlug || menuLocation;

const data = await fetchGQL<GetMenuResponse>(GET_MENU, {
  id,
  idType,
});

const menuItems: MenuItem[] = data?.menu?.menuItems?.nodes || [];

// Separate top-level items (those without a parentId) from children
const topLevelItems = menuItems.filter((item) => !item.parentId);
const childItems = menuItems.filter((item) => item.parentId);

/**
 * Get children for a given parent menu item.
 */
function getChildren(parentId: string): MenuItem[] {
  return childItems.filter((item) => item.parentId === parentId);
}

/**
 * Resolve the best possible href for a menu item.
 *
 * Priority order:
 * 1. `connectedNode.node.uri` – canonical URI from the linked term/post (always correct)
 * 2. `path` – relative path from the menu item (may be stale after permalink changes)
 * 3. `url` – absolute URL from the menu item (fallback)
 *
 * WordPress menu items may contain absolute URLs like https://backend.janheder.space/...
 * We strip the origin to make them relative for the headless frontend.
 */
function resolveMenuItemHref(item: MenuItem): string {
  // Prefer the canonical URI from the connected node (term, post, etc.)
  const canonicalUri = item.connectedNode?.node?.uri;
  if (canonicalUri) {
    return canonicalUri;
  }

  const raw = item.path || item.url;
  if (!raw) return '#';

  try {
    const parsed = new URL(raw);
    return parsed.pathname + parsed.search + parsed.hash;
  } catch {
    // raw is already a relative path like "/category/clothing/"
    return raw;
  }
}
---

{
  menuItems.length > 0 && (
    <nav class="main-nav">
      <ul class="main-nav__list">
        {topLevelItems.map((item) => {
          const children = getChildren(item.id);
          const hasChildren = children.length > 0;
          return (
            <li class:list={['main-nav__item', hasChildren && 'main-nav__item--has-children']}>
              <a
                href={resolveMenuItemHref(item)}
                target={item.target || undefined}
                class:list={['main-nav__link', ...(item.cssClasses || [])]}
              >
                {item.label}
              </a>
              {hasChildren && (
                <ul class="main-nav__submenu">
                  {children.map((child) => (
                    <li class="main-nav__submenu-item">
                      <a
                        href={resolveMenuItemHref(child)}
                        target={child.target || undefined}
                        class:list={['main-nav__submenu-link', ...(child.cssClasses || [])]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<style>
  .main-nav__list {
    display: flex;
    gap: var(--spacing-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .main-nav__item {
    position: relative;
  }

  .main-nav__link {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast) ease;
    padding: 0.8rem 0;
    display: inline-block;
  }

  .main-nav__link:hover {
    color: var(--color-primary);
  }

  /* Submenu (dropdown) */
  .main-nav__submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: var(--color-surface);
    border: 0.1rem solid var(--color-border);
    border-radius: 0.4rem;
    padding: var(--spacing-sm) 0;
    min-width: 20rem;
    list-style: none;
    margin: 0;
    z-index: 200;
    box-shadow: 0 0.4rem 1.2rem rgba(0, 0, 0, 0.1);
  }

  .main-nav__item--has-children:hover .main-nav__submenu,
  .main-nav__item--has-children:focus-within .main-nav__submenu {
    display: block;
  }

  .main-nav__submenu-item {
    margin: 0;
  }

  .main-nav__submenu-link {
    display: block;
    padding: 0.6rem var(--spacing-md);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: background-color var(--transition-fast) ease, color var(--transition-fast) ease;
    white-space: nowrap;
  }

  .main-nav__submenu-link:hover {
    background-color: var(--color-border);
    color: var(--color-primary);
  }
</style>
