---
import type { Product } from '../types/woo.types';
import { formatPrice, rewriteAssetUrl } from '../lib/utils';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const imageSrc = product.image?.sourceUrl 
  ? rewriteAssetUrl(product.image.sourceUrl) 
  : 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&q=80&w=600'; // high quality placeholder

const hasSale = product.onSale && product.regularPrice && product.salePrice;
const cleanPrice = formatPrice(product.price);
const cleanRegularPrice = formatPrice(product.regularPrice);
const cleanSalePrice = formatPrice(product.salePrice);
const isVariableProduct = product.__typename === 'VariableProduct';
---

<article class="product-card">
  <a href={`/product/${product.slug}`} class="product-card-link" aria-label={`Zobrazit detail produktu ${product.name}`}>
    <div class="product-image-wrapper">
      {product.onSale && <span class="product-badge">Sleva</span>}
      <img 
        src={imageSrc} 
        alt={product.image?.altText || product.name} 
        class="product-image" 
        loading="lazy" 
      />
    </div>
  </a>

  <div class="product-info">
    <a href={`/product/${product.slug}`} class="product-title-link">
      <h3 class="product-name">{product.name}</h3>
    </a>
    
    <div class="product-price-container">
      {hasSale ? (
        <div class="price-group">
          <span class="price-original" aria-label="Původní cena">{cleanRegularPrice}</span>
          <span class="price-current price-sale" aria-label="Akční cena">{cleanSalePrice}</span>
        </div>
      ) : (
        <span class="price-current" aria-label="Cena">{cleanPrice}</span>
      )}
    </div>

    {isVariableProduct ? (
      <a 
        href={`/product/${product.slug}`}
        class="btn btn-primary btn-full"
        aria-label={`Vybrat možnosti produktu ${product.name}`}
      >
        Vybrat možnosti
      </a>
    ) : (
      <button 
        class="btn btn-primary btn-full ajax-add-to-cart" 
        data-product-id={product.databaseId}
        aria-label={`Přidat ${product.name} do košíku`}
      >
        Do košíku
      </button>
    )}
  </div>
</article>

<style>
  .product-card {
    background-color: var(--color-surface);
    border: 0.1rem solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card:hover {
    transform: translateY(-0.6rem);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-border-hover);
  }

  .product-card-link {
    display: block;
    text-decoration: none;
  }

  .product-image-wrapper {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-size: 1.1rem;
    font-weight: 700;
    padding: 0.4rem var(--spacing-sm);
    border-radius: var(--radius-xs);
    z-index: 10;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: var(--shadow-sm);
  }

  .product-info {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-title-link {
    text-decoration: none;
    color: inherit;
    margin-bottom: var(--spacing-xs);
  }

  .product-title-link:hover {
    color: var(--color-primary);
  }

  .product-name {
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.35;
    /* Limit name to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 4.8rem;
  }

  .product-price-container {
    margin-bottom: var(--spacing-lg);
    margin-top: auto;
  }

  .price-current {
    font-size: 2.0rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .price-sale {
    color: var(--color-primary);
  }

  .price-group {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .price-original {
    font-size: 1.5rem;
    color: var(--color-text-muted);
    text-decoration: line-through;
    font-weight: 500;
  }

  /* Reusable button styling in card context */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-sm) var(--spacing-xl);
    font-size: 1.5rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
    text-decoration: none;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-0.2rem);
    box-shadow: 0 0.4rem 1.2rem rgba(171, 71, 129, 0.2);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-full {
    width: 100%;
  }
</style>
