---
/**
 * LoadingIndicator.astro
 * Zobrazuje progres bar v horní části stránky během Astro View Transitions.
 */
---

<div id="loading-indicator" class="loading-indicator" aria-hidden="true" transition:persist>
  <div class="loading-indicator-bar"></div>
</div>

<style>
  .loading-indicator {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    z-index: 99999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .loading-indicator-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #AB4781 0%, #FFB300 50%, #AB4781 100%);
    background-size: 200% 100%;
    animation: loading-shimmer 2s linear infinite;
    box-shadow: 0 0 15px rgba(171, 71, 129, 0.7);
    transition: width 0.4s cubic-bezier(0.1, 0.05, 0.1, 1);
  }

  @keyframes loading-shimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .loading-indicator.active {
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .loading-indicator.finishing {
    opacity: 0;
    transition: opacity 0.6s ease-in 0.3s;
  }

  .loading-indicator.finishing .loading-indicator-bar {
    width: 100% !important;
    transition: width 0.3s ease-out;
  }
</style>

<script>
  let progress = 0;
  let interval: any = null;
  let isTransitioning = false;

  function getElements() {
    const indicator = document.getElementById('loading-indicator');
    const progressBar = indicator?.querySelector('.loading-indicator-bar') as HTMLElement;
    return { indicator, progressBar };
  }

  const startLoading = () => {
    isTransitioning = true;
    const { indicator, progressBar } = getElements();
    if (!indicator || !progressBar) return;

    // Reset state
    indicator.classList.remove('finishing');
    indicator.classList.add('active');
    progress = 0;
    progressBar.style.width = '0%';

    // Initial jump
    setTimeout(() => {
      if (!isTransitioning) return; // Guard against fast end
      const { progressBar: currentBar } = getElements();
      if (currentBar) currentBar.style.width = '30%';
      progress = 30;
    }, 10);

    // Incremental progress
    clearInterval(interval);
    interval = setInterval(() => {
      if (progress < 90) {
        progress += Math.random() * 5;
        if (progress > 90) progress = 90;
        const { progressBar: currentBar } = getElements();
        if (currentBar) currentBar.style.width = `${progress}%`;
      }
    }, 400);
  };

  const endLoading = () => {
    isTransitioning = false;
    const { indicator, progressBar } = getElements();
    if (!indicator || !progressBar) return;

    clearInterval(interval);
    indicator.classList.add('finishing');
    indicator.classList.remove('active');
    
    // Complete the bar
    if (progressBar) progressBar.style.width = '100%';
    
    setTimeout(() => {
      if (isTransitioning) return; // Guard against a new transition starting
      const { indicator: currentInd, progressBar: currentBar } = getElements();
      if (currentBar) currentBar.style.width = '0%';
      if (currentInd) currentInd.classList.remove('finishing');
    }, 900);
  };

  // Listen to Astro View Transition events
  document.addEventListener('astro:before-preparation', startLoading);
  document.addEventListener('astro:after-preparation', endLoading);
  
  // Extra safety for fast transitions or errors
  document.addEventListener('astro:after-swap', () => {
    const { indicator } = getElements();
    if (indicator?.classList.contains('active')) {
      endLoading();
    }
  });

  // Initial setup for non-transition starts
  document.addEventListener('DOMContentLoaded', () => getElements());
</script>
